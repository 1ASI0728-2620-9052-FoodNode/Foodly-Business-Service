# Reference only: Spring Boot does not import this file automatically.
# Export values in your process. Docker Compose reads .env for interpolation.
SERVER_PORT=8080
# Native Windows development instance. For the optional Docker Compose use port 27017.
MONGODB_URI=mongodb://127.0.0.1:27018/foodly_business?replicaSet=rs0
RABBITMQ_ADDRESSES=amqp://localhost:5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Set /foodly-business-dev for the isolated native broker; the application default is /.
RABBITMQ_VHOST=/foodly-business-dev
BUSINESS_EVENTS_EXCHANGE=foodly.business
OUTBOX_ENABLED=true
OUTBOX_DELAY_MS=1000
# Business pins HS256; there is no algorithm-selection environment variable.
# Contract aligned with Foodly-IAM-Service (PR feature/jwt-issuer-audience): IAM signs HS256 and
# emits iss=foodly-iam, aud including foodly-business and role HUARIQUE_OWNER / GASTRONOMIC_EXPLORER.
# See docs/iam-business-jwt.md. Use scripts/local-auth.ps1 for an independent, ignored local key.
# Shared key: exactly the same Base64 value IAM receives as JWT_SECRET_BASE64 (at least 32 decoded
# bytes). It has no default on purpose: set it only in the environment, never in Git.
IAM_JWT_SECRET_BASE64=
# These three match the application defaults and IAM's JWT_ISSUER; override only if IAM changes them.
IAM_JWT_ISSUER=foodly-iam
IAM_JWT_AUDIENCE=foodly-business
IAM_OWNER_ROLE=HUARIQUE_OWNER
# Real account credentials: see docs/cloudinary.md and scripts/cloudinary.ps1.
# CLOUDINARY_URL is not interpreted. Never put real keys in this reference file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
