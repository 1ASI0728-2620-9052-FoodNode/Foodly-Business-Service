# Reference only: Spring Boot does not import this file automatically.
# Export values in your process. Docker Compose reads .env for interpolation.
SERVER_PORT=8080
# Native Windows development instance. For the optional Docker Compose use port 27017.
MONGODB_URI=mongodb://127.0.0.1:27018/foodly_business?replicaSet=rs0
RABBITMQ_ADDRESSES=amqp://localhost:5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Set /foodly-business-dev for the isolated native broker; the application default is /.
RABBITMQ_VHOST=/foodly-business-dev
BUSINESS_EVENTS_EXCHANGE=foodly.business
OUTBOX_ENABLED=true
OUTBOX_DELAY_MS=1000
# Business currently pins HS256; there is no algorithm-selection environment variable.
# IAM develop uses HS256 but currently omits issuer/audience, which Business requires.
# Use scripts/local-auth.ps1 for an independent, ignored local development key.
# For real IAM use its actual shared key, Base64 encoded (at least 32 decoded bytes).
IAM_JWT_SECRET_BASE64=
# Proposed, pending agreement with IAM: issuer foodly-iam, audience foodly-business.
# See docs/iam-business-jwt.md. Leave the actual shared key outside Git.
IAM_JWT_ISSUER=
IAM_JWT_AUDIENCE=
# Exact role observed in IAM develop; Business's default remains OWNER unless overridden.
IAM_OWNER_ROLE=HUARIQUE_OWNER
# Real account credentials: see docs/cloudinary.md and scripts/cloudinary.ps1.
# CLOUDINARY_URL is not interpreted. Never put real keys in this reference file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
